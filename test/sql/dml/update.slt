DROP TABLE IF EXISTS tbl1;

statement ok
CREATE TABLE tbl1(c1 EMBEDDING(int,2));

statement ok
INSERT INTO tbl1 (c1) VALUES ([1,2]), ([2,2]), ([3,2]);

statement ok
UPDATE tbl1 SET c1 = [10,20] WHERE 1 = 1;

query I rowsort
