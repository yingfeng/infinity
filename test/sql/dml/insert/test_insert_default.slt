# Test embedding column with NULL value
statement ok
DROP TABLE IF EXISTS test_embedding_null;

statement ok
CREATE TABLE test_embedding_null (col1 INT, col2 EMBEDDING(FLOAT,4));

query I
INSERT INTO test_embedding_null VALUES (1, NULL);
----

query I
INSERT INTO test_embedding_null VALUES (2, [1, 2, 3, 4]);
----

query II
SELECT * FROM test_embedding_null ORDER BY col1;
----
1 null
2 [1,2,3,4]

query II
SELECT col1, col2 FROM test_embedding_null WHERE col2 IS NULL;
----
1 null

query II
SELECT col1, col2 FROM test_embedding_null WHERE col2 IS NOT NULL;
----
2 [1,2,3,4]

statement ok
DROP TABLE test_embedding_null;

# Test embedding column with DEFAULT and explicit NULL
statement ok
DROP TABLE IF EXISTS test_embedding_null_default;

statement ok
CREATE TABLE test_embedding_null_default (col1 INT, col2 EMBEDDING(FLOAT,4) DEFAULT [9.0, 8.0, 7.0, 6.0]);

query I
INSERT INTO test_embedding_null_default VALUES (1, NULL);
----

query I
INSERT INTO test_embedding_null_default VALUES (2);
----

query II
SELECT * FROM test_embedding_null_default ORDER BY col1;
----
1 null
2 [9,8,7,6]

statement ok
DROP TABLE test_embedding_null_default;
